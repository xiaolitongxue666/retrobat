# ROM library and BIOS library.
# Relative values roms / bios keep the libraries inside this repository.
# Those directories are gitignored.
# An absolute path makes roms or bios a directory junction to that path.
# Copy this file to .env and edit it. .env is gitignored.

RETROBAT_ROMS=roms
RETROBAT_BIOS=bios

# Optional. curl honors these for emulator downloads. Leave unset when no proxy is needed.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
